@baseUrl = http://localhost:3000

### Crear Alojamiento
POST {{baseUrl}}/alojamientos/crear
Content-Type: application/json

{
    "id_host": "63691c82-502a-4bf8-8b05-fd6cb30a3cb0",
    "titulo": "Casa corazón",
    "descripcion": "zhy",
    "precio": 20,
    "capacidad": 1,
    "ubicacion": "Ciudad de Mexico", 
    "servicios": [
        "Antena parabolica",
        "vaye",
        "Cenotes"
    ]
}

#--------------------------------------------------#

### Obtener todos los alojamientos
GET {{baseUrl}}/alojamientos/consulta

#--------------------------------------------------#
### Obtener alojamiento por ID
GET {{baseUrl}}/alojamientos/consulta
Content-Type: application/json

{
    "id": "5e67543b63ce4853b7912b484760a385"
}

#--------------------------------------------------#

### Actualizar alojamiento
PUT {{baseUrl}}/alojamientos/editar
Content-Type: application/json

{
      "id": "9efaefe7-50c6-469f-80e4-77e5cf6f9713",
      "id_host": "63691c82-502a-4bf8-8b05-fd6cb30a3cb0",
      "titulo": "Casa corazón",
      "descripcion": "zhy",
      "status": 1,
      "precio": 20.00,
      "capacidad": 1,
      "ubicacion": "Ciudad de Mexico",
      "servicios": [
        "Antena parabolica",
        "vaye",
        "Cenotes"
      ]
}

#--------------------------------------------------#

### Eliminar alojamiento
DELETE {{baseUrl}}/alojamientos/drop
Content-Type: application/json

{
    "id": "5e67543b63ce4853b7912b484760a385"
}